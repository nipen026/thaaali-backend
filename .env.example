PORT=4000
# Supabase Postgres direct connection string — Project Settings -> Database -> Connection string (URI, "Session" or "Transaction" pooler).
# This is NOT the NEXT_PUBLIC_SUPABASE_URL/publishable key pair (those are for the client-SDK/PostgREST path, which this backend does not use).
# NOTE: `prisma migrate dev`/`deploy` needs advisory locks, which the Transaction pooler
# (port 6543) does not support — it will hang with no output. Run migrations with the
# Session pooler URL instead (same host, port 5432); this app-runtime URL can stay on 6543.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres
JWT_SECRET=change_this_in_every_environment
CORS_ORIGIN=http://localhost:5173
# Frontend origin — used to build links inside emails (e.g. the email-verification link).
APP_URL=http://localhost:5173
# Resend (https://resend.com) API key for sending transactional email. Leave unset in dev
# to skip sending and log the verification link to the console instead.
RESEND_API_KEY=
# Must be a verified sender/domain in your Resend account.
EMAIL_FROM=THAAALI <onboarding@resend.dev>
