PORT=4000
# Supabase Postgres direct connection string — Project Settings -> Database -> Connection string (URI, "Session" or "Transaction" pooler).
# This is NOT the NEXT_PUBLIC_SUPABASE_URL/publishable key pair (those are for the client-SDK/PostgREST path, which this backend does not use).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres
JWT_SECRET=change_this_in_every_environment
CORS_ORIGIN=http://localhost:5173
